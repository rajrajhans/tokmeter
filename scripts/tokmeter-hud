#!/usr/bin/env bash
# Build (if needed) and run TokmeterHUD menubar app.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PKG="$ROOT/macos/TokmeterHUD"
BIN_DEBUG="$PKG/.build/debug/TokmeterHUD"
BIN_RELEASE="$PKG/.build/release/TokmeterHUD"

# Prefer a real Apple toolchain over nix-managed xcode-select / SDK shims.
# direnv/nix shells often inject an incomplete apple-sdk that breaks `swift build`.
if [[ -x /Library/Developer/CommandLineTools/usr/bin/swift ]]; then
  export PATH="/Library/Developer/CommandLineTools/usr/bin:$PATH"
fi
if [[ -d /Library/Developer/CommandLineTools ]]; then
  if [[ "${DEVELOPER_DIR:-}" == /nix/* ]] || [[ -z "${DEVELOPER_DIR:-}" && "$(xcode-select -p 2>/dev/null || true)" == /nix/* ]]; then
    export DEVELOPER_DIR="/Library/Developer/CommandLineTools"
  fi
  if [[ ! -d "${SDKROOT:-}" ]] || [[ "${SDKROOT:-}" == /nix/* ]]; then
    if [[ -d /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk ]]; then
      export SDKROOT="/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
    fi
  fi
fi

need_build=1
if [[ -x "$BIN_RELEASE" ]]; then
  # Rebuild if sources are newer than the binary.
  if [[ -z "$(find "$PKG/Sources" "$PKG/Package.swift" -newer "$BIN_RELEASE" 2>/dev/null | head -1)" ]]; then
    need_build=0
  fi
fi

if [[ "$need_build" -eq 1 ]]; then
  echo "Building TokmeterHUD (release)…"
  (cd "$PKG" && swift build -c release)
fi

BIN="$BIN_RELEASE"
if [[ ! -x "$BIN" ]]; then
  BIN="$BIN_DEBUG"
fi

if [[ ! -x "$BIN" ]]; then
  echo "error: TokmeterHUD binary not found after build" >&2
  exit 1
fi

# Providers implemented in this checkout. Used to reject a stale `result/`
# (or ~/.local/bin copy) that predates a newly added provider — that used
# to crash the HUD with `Cannot read properties of undefined (reading
# 'fetchUsage')` as soon as config.json listed the new account.
workspace_providers() {
  local f base
  if [[ -d "$ROOT/src/providers" ]]; then
    for f in "$ROOT/src/providers"/*.ts; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f" .ts)"
      case "$base" in
        index|types) ;;
        *) printf '%s\n' "$base" ;;
      esac
    done
  else
    printf '%s\n' claude codex grok cursor
  fi
}

# True if this binary looks new enough for the HUD: has `stats`, and its
# --help mentions every workspace provider (case-insensitive).
cli_is_current() {
  local bin="$1"
  [[ -n "$bin" && -x "$bin" ]] || return 1
  local help
  help="$("$bin" --help 2>&1 || true)"
  grep -q 'stats' <<<"$help" || return 1
  local p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    grep -qi -- "$p" <<<"$help" || return 1
  done < <(workspace_providers)
  return 0
}

pick_tokmeter() {
  local c
  for c in \
    "$ROOT/result/bin/tokmeter" \
    "${HOME}/.local/bin/tokmeter" \
    "${HOME}/.nix-profile/bin/tokmeter" \
    /run/current-system/sw/bin/tokmeter
  do
    if cli_is_current "$c"; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  if command -v tokmeter >/dev/null 2>&1; then
    c="$(command -v tokmeter)"
    if cli_is_current "$c"; then
      printf '%s\n' "$c"
      return 0
    fi
  fi
  return 1
}

# Heal a stale ./result even when another current CLI exists. The HUD
# also hardcodes ~/projects/tokmeter/result/bin/tokmeter; a pre-cursor
# build there crashes with `reading 'fetchUsage'`.
if command -v nix >/dev/null 2>&1 && [[ -f "$ROOT/flake.nix" ]]; then
  if [[ ! -x "$ROOT/result/bin/tokmeter" ]] || ! cli_is_current "$ROOT/result/bin/tokmeter"; then
    echo "Updating tokmeter CLI to match workspace providers…"
    if ! (cd "$ROOT" && nix build .); then
      echo "warning: nix build failed; falling back to another tokmeter" >&2
    fi
  fi
fi

if [[ -z "${TOKMETER_BIN:-}" ]]; then
  if bin="$(pick_tokmeter)"; then
    export TOKMETER_BIN="$bin"
  fi
fi

# Keep ~/.local/bin in sync so GUI launches (no direnv PATH) find a modern CLI.
# Never clobber it with a stale wrapper — that's what broke the HUD.
if [[ -n "${TOKMETER_BIN:-}" ]] && cli_is_current "$TOKMETER_BIN"; then
  mkdir -p "${HOME}/.local/bin"
  if [[ "$TOKMETER_BIN" != "${HOME}/.local/bin/tokmeter" ]]; then
    cp -f "$TOKMETER_BIN" "${HOME}/.local/bin/tokmeter"
    chmod +x "${HOME}/.local/bin/tokmeter"
  fi
  export TOKMETER_BIN="${HOME}/.local/bin/tokmeter"
fi

exec env TOKMETER_BIN="${TOKMETER_BIN:-}" "$BIN" "$@"
