# Reload shell when flake / package metadata changes
watch_file flake.nix
watch_file flake.lock
watch_file package.json

use flake

# Belt-and-suspenders: never keep a store path as the project root.
# (Older flake revisions exported TOKMETER_ROOT=/nix/store/...-source)
if [ -n "${TOKMETER_ROOT:-}" ]; then
  case "$TOKMETER_ROOT" in
    /nix/store/*)
      unset TOKMETER_ROOT
      ;;
  esac
fi

if [ -f "$PWD/flake.nix" ] && [ -f "$PWD/src/index.ts" ] && [ -w "$PWD" ]; then
  export TOKMETER_ROOT="$PWD"
fi
