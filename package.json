{
  "name": "tokmeter",
  "version": "0.1.0",
  "description": "Unified CLI for Claude Code, OpenAI Codex, Grok, and Cursor usage",
  "type": "module",
  "bin": {
    "tokmeter": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "usage",
    "claude",
    "codex",
    "grok",
    "cursor",
    "tokens"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
